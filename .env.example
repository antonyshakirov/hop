# Notarization credentials — template. Copy to .env and fill in the password.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored; this template is not, and must stay free of real values.
# The release script reads these when submitting a build to Apple for
# notarization. Signing itself needs none of them — only the Developer ID
# certificate in the login keychain.

# Apple ID that holds the Apple Developer Program membership.
APPLE_ID=me@antonshakirov.com

# Team ID, taken from the certificate: "Developer ID Application: … (TEAM)".
APPLE_TEAM_ID=8GL36WUJPX

# App-specific password, NOT the account password. Create one at
# appleid.apple.com → Sign-In and Security → App-Specific Passwords.
# Format is four groups of four lowercase letters.
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
