+#[tokio::test]
+async fn selective_storage_restart_keeps_overlay_and_skipped_data() -> anyhow::Result<()> {
+    let (root, session, handle) = fixture().await?;
+    let id = skipped_id(&handle);
+    let hash = handle.info_hash();
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        paused.files.pwrite_all(id, 35000, b"cached tail")?;
+        Ok(())
+    })?;
+    drop(handle);
+    session.stop().await;
+    drop(session);
+    let next = Session::new_with_opts(
+        root.path().join("output"),
+        SessionOptions {
+            dht: None,
+            disable_trackers: true,
+            disable_local_service_discovery: true,
+            persistence: Some(SessionPersistenceConfig::Json {
+                folder: Some(root.path().join("session")),
+            }),
+            fastresume: true,
+            ..Default::default()
+        },
+    )
+    .await?;
+    let handle = next.get(hash.into()).context("torrent was not restored")?;
+    tokio::time::timeout(Duration::from_secs(10), handle.wait_until_initialized()).await??;
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        let mut bytes = [0; 11];
+        paused.files.pread_exact(id, 35000, &mut bytes)?;
+        assert_eq!(&bytes, b"cached tail");
+        assert!(paused.files.pread_exact(id, 100, &mut bytes).is_err());
+        Ok(())
+    })?;
+    assert_eq!(
+        std::fs::read(root.path().join("output/skipped/middle.bin"))?,
+        b"existing user bytes"
+    );
+    assert!(!root.path().join("output/never").exists());
+    drop(handle);
+    next.stop().await;
+    Ok(())
+}
