+use std::{collections::HashSet, io::IoSlice, path::Path, time::Duration};
+
+use anyhow::Context;
+use tempfile::TempDir;
+
+use crate::{
+    AddTorrent, AddTorrentOptions, CreateTorrentOptions, ManagedTorrentState, Session,
+    SessionOptions, SessionPersistenceConfig, create_torrent, spawn_utils::BlockingSpawner,
+    torrent_state::ManagedTorrentHandle,
+};
+
+async fn fixture() -> anyhow::Result<(TempDir, std::sync::Arc<Session>, ManagedTorrentHandle)> {
+    fixture_with_overwrite(true).await
+}
+
+async fn fixture_with_overwrite(
+    overwrite: bool,
+) -> anyhow::Result<(TempDir, std::sync::Arc<Session>, ManagedTorrentHandle)> {
+    let root = TempDir::new()?;
+    let source = root.path().join("source");
+    for (name, byte, size) in [
+        ("chosen/first.bin", 1, 12000),
+        ("skipped/middle.bin", 2, 36000),
+        ("chosen/last.bin", 3, 15000),
+        ("empty/zero.bin", 0, 0),
+        ("never/file.bin", 4, 128),
+    ] {
+        let path = source.join(name);
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        std::fs::write(path, vec![byte; size])?;
+    }
+    let torrent = create_torrent(
+        &source,
+        CreateTorrentOptions {
+            piece_length: Some(16384),
+            ..Default::default()
+        },
+        &BlockingSpawner::new(1),
+    )
+    .await?;
+    let info = torrent.as_info().info.data.clone().validate()?;
+    let selected = info
+        .iter_file_details()
+        .enumerate()
+        .filter_map(|(id, file)| {
+            file.filename
+                .to_pathbuf()
+                .starts_with("chosen")
+                .then_some(id)
+        })
+        .collect();
+    let output = root.path().join("output");
+    std::fs::create_dir_all(output.join("skipped"))?;
+    std::fs::write(output.join("skipped/middle.bin"), b"existing user bytes")?;
+    let session = Session::new_with_opts(
+        output.clone(),
+        SessionOptions {
+            dht: None,
+            disable_trackers: true,
+            disable_local_service_discovery: true,
+            persistence: Some(SessionPersistenceConfig::Json {
+                folder: Some(root.path().join("session")),
+            }),
+            ..Default::default()
+        },
+    )
+    .await?;
+    let handle = session
+        .add_torrent(
+            AddTorrent::from_bytes(torrent.as_bytes()?),
+            Some(AddTorrentOptions {
+                paused: true,
+                overwrite,
+                output_folder: Some(output.to_string_lossy().into()),
+                only_files: Some(selected),
+                ..Default::default()
+            }),
+        )
+        .await?
+        .into_handle()
+        .context("missing handle")?;
+    tokio::time::timeout(Duration::from_secs(10), handle.wait_until_initialized()).await??;
+    Ok((root, session, handle))
+}
+
+fn skipped_id(handle: &ManagedTorrentHandle) -> usize {
+    handle
+        .metadata
+        .load()
+        .as_ref()
+        .unwrap()
+        .file_infos
+        .iter()
+        .position(|file| file.relative_filename == Path::new("skipped/middle.bin"))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn selective_storage_initialization_preserves_skipped_paths_and_bytes() -> anyhow::Result<()>
+{
+    let (root, session, handle) = fixture().await?;
+    let output = root.path().join("output");
+    assert!(!output.join("empty").exists());
+    assert!(!output.join("never").exists());
+    assert_eq!(
+        std::fs::read(output.join("skipped/middle.bin"))?,
+        b"existing user bytes"
+    );
+    drop(handle);
+    session.stop().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn selective_storage_shared_bytes_do_not_modify_skipped_payload() -> anyhow::Result<()> {
+    let (root, session, handle) = fixture().await?;
+    let id = skipped_id(&handle);
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        paused.files.pwrite_all_vectored(
+            id,
+            0,
+            [IoSlice::new(b"shared "), IoSlice::new(b"bytes")],
+        )?;
+        let mut read = [0; 12];
+        paused.files.pread_exact(id, 0, &mut read)?;
+        assert_eq!(&read, b"shared bytes");
+        Ok(())
+    })?;
+    assert_eq!(
+        std::fs::read(root.path().join("output/skipped/middle.bin"))?,
+        b"existing user bytes"
+    );
+    drop(handle);
+    session.stop().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn selective_storage_selection_promotes_only_cached_ranges() -> anyhow::Result<()> {
+    let (root, session, handle) = fixture().await?;
+    let id = skipped_id(&handle);
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        paused.files.pwrite_all(id, 9, b"cached")?;
+        Ok(())
+    })?;
+    handle.update_only_files(&HashSet::from([id]))?;
+    let bytes = std::fs::read(root.path().join("output/skipped/middle.bin"))?;
+    assert_eq!(&bytes[..9], b"existing ");
+    assert_eq!(&bytes[9..15], b"cached");
+    assert_eq!(&bytes[15..19], b"ytes");
+    drop(handle);
+    session.stop().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn selective_storage_deselection_routes_later_writes_to_cache() -> anyhow::Result<()> {
+    let (root, session, handle) = fixture().await?;
+    let id = skipped_id(&handle);
+    handle.update_only_files(&HashSet::from([id]))?;
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        paused.files.pwrite_all(id, 0, b"selected bytes")?;
+        Ok(())
+    })?;
+    let path = root.path().join("output/skipped/middle.bin");
+    let selected_bytes = std::fs::read(&path)?;
+    handle.update_only_files(&HashSet::new())?;
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        paused.files.pwrite_all(id, 0, b"cached bytes!!")?;
+        let moved = paused.files.take()?;
+        assert!(paused.files.pwrite_all(id, 0, b"wrong").is_err());
+        assert!(
+            paused
+                .files
+                .remove_file(id, Path::new("skipped/middle.bin"))
+                .is_err()
+        );
+        assert!(paused.files.remove_cached_data().is_err());
+        let mut bytes = [0; 14];
+        moved.pread_exact(id, 0, &mut bytes)?;
+        assert_eq!(&bytes, b"cached bytes!!");
+        Ok(())
+    })?;
+    assert_eq!(std::fs::read(&path)?, selected_bytes);
+    drop(handle);
+    session.stop().await;
+    Ok(())
+}
