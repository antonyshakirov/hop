+#[tokio::test]
+async fn selective_storage_delete_in_error_state_removes_payload_and_cached_ranges()
+-> anyhow::Result<()> {
+    use crate::storage::{StorageFactory, TorrentStorage, filesystem::FilesystemStorageFactory};
+    let (root, session, handle) = fixture().await?;
