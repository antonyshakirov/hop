@@ -0,0 +1,561 @@
+use std::{
+    collections::BTreeMap,
+    fs::{File, OpenOptions},
+    io::{Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+};
+
+use anyhow::{Context, ensure};
+use sha1w::{ISha1, Sha1};
+
+use super::opened_file::OurFileExt;
+
+const MAGIC: &[u8; 8] = b"RQPART01";
+const HEADER_SIZE: usize = 28;
+const HEADER_LEN: u64 = HEADER_SIZE as u64;
+const RECORD_HEADER: usize = 24;
+const CHECKSUM_LEN: u64 = 20;
+const CLEAR: u64 = u64::MAX;
+
+#[derive(Clone, Copy)]
+struct Range {
+    end: u64,
+    data_at: u64,
+}
+
+pub(super) struct PartFile {
+    path: PathBuf,
+    identity: [u8; 20],
+    lengths: Vec<u64>,
+    file: Option<File>,
+    committed: u64,
+    ranges: Vec<BTreeMap<u64, Range>>,
+    live_bytes: u64,
+    range_count: u64,
+}
+
+fn open_options() -> OpenOptions {
+    let mut options = OpenOptions::new();
+    options.read(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600).custom_flags(nix::libc::O_NOFOLLOW);
+    }
+    options
+}
+
+fn checksum(header: &[u8], data: &[u8]) -> [u8; 20] {
+    let mut hash = Sha1::new();
+    hash.update(header);
+    hash.update(data);
+    hash.finish()
+}
+
+impl PartFile {
+    pub(super) fn open(
+        path: PathBuf,
+        identity: [u8; 20],
+        lengths: Vec<u64>,
+    ) -> anyhow::Result<Self> {
+        let file = match open_options().open(&path) {
+            Ok(file) => {
+                ensure!(
+                    file.metadata()?.is_file(),
+                    "part cache is not a regular file"
+                );
+                file.try_lock().context("part cache is in use")?;
+                Some(file)
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+            Err(error) => return Err(error).context("opening part cache"),
+        };
+        let mut result = Self {
+            ranges: vec![BTreeMap::new(); lengths.len()],
+            path,
+            identity,
+            lengths,
+            file,
+            committed: HEADER_LEN,
+            live_bytes: 0,
+            range_count: 0,
+        };
+        result.replay()?;
+        Ok(result)
+    }
+
+    pub(super) fn exists(&self) -> bool {
+        self.file.is_some()
+    }
+
+    fn validate(&self, id: usize, offset: u64, length: u64) -> anyhow::Result<()> {
+        let file_length = *self.lengths.get(id).context("invalid part cache file id")?;
+        ensure!(
+            offset
+                .checked_add(length)
+                .is_some_and(|end| end <= file_length),
+            "part cache range exceeds file"
+        );
+        Ok(())
+    }
+
+    fn insert(&mut self, id: usize, start: u64, length: u64, data_at: u64) {
+        let end = start + length;
+        let map = &mut self.ranges[id];
+        let overlapping: Vec<_> = map
+            .range(..end)
+            .rev()
+            .take_while(|(_, range)| range.end > start)
+            .map(|(&key, &range)| (key, range))
+            .collect();
+        let before = map.len();
+        let mut removed = 0;
+        let mut retained = 0;
+        for (key, range) in overlapping {
+            map.remove(&key);
+            removed += range.end - key;
+            if key < start {
+                map.insert(
+                    key,
+                    Range {
+                        end: start,
+                        data_at: range.data_at,
+                    },
+                );
+                retained += start - key;
+            }
+            if range.end > end {
+                map.insert(
+                    end,
+                    Range {
+                        end: range.end,
+                        data_at: range.data_at + end - key,
+                    },
+                );
+                retained += range.end - end;
+            }
+        }
+        map.insert(start, Range { end, data_at });
+        self.live_bytes = self.live_bytes - removed + retained + length;
+        self.range_count = self.range_count - before as u64 + map.len() as u64;
+    }
+
+    fn replay(&mut self) -> anyhow::Result<()> {
+        let Some(file) = self.file.as_ref() else {
+            return Ok(());
+        };
+        let mut header = [0; HEADER_SIZE];
+        file.pread_exact(0, &mut header)
+            .context("incomplete part cache header")?;
+        ensure!(
+            &header[..8] == MAGIC && header[8..] == self.identity,
+            "unrecognized part cache"
+        );
+        let size = file.metadata()?.len();
+        let mut buffer = [0; 65536];
+        loop {
+            let position = self.committed;
+            if size - position < RECORD_HEADER as u64 {
+                break;
+            }
+            let file = self.file.as_ref().unwrap();
+            let mut record = [0; RECORD_HEADER];
+            file.pread_exact(position, &mut record)?;
+            let id = usize::try_from(u64::from_le_bytes(record[..8].try_into()?))?;
+            let offset = u64::from_le_bytes(record[8..16].try_into()?);
+            let length = u64::from_le_bytes(record[16..].try_into()?);
+            ensure!(id < self.lengths.len(), "invalid part cache file id");
+            if offset == CLEAR {
+                ensure!(length == 0, "invalid part cache clear record");
+            } else {
+                self.validate(id, offset, length)?;
+                ensure!(length > 0, "empty part cache range");
+            }
+            let data_at = position + RECORD_HEADER as u64;
+            let end = data_at
+                .checked_add(length)
+                .and_then(|n| n.checked_add(CHECKSUM_LEN))
+                .context("part cache record overflow")?;
+            if end > size {
+                break;
+            }
+            let mut hash = Sha1::new();
+            hash.update(&record);
+            let mut consumed = 0;
+            while consumed < length {
+                let n = usize::try_from((length - consumed).min(buffer.len() as u64))?;
+                file.pread_exact(data_at + consumed, &mut buffer[..n])?;
+                hash.update(&buffer[..n]);
+                consumed += n as u64;
+            }
+            let mut expected = [0; 20];
+            file.pread_exact(data_at + length, &mut expected)?;
+            ensure!(hash.finish() == expected, "part cache checksum mismatch");
+            if offset == CLEAR {
+                self.clear_index(id);
+            } else {
+                self.insert(id, offset, length, data_at);
+            }
+            self.committed = end;
+        }
+        Ok(())
+    }
+
+    fn create(&mut self) -> anyhow::Result<()> {
+        if self.file.is_some() {
+            return Ok(());
+        }
+        let parent = self.path.parent().context("part cache has no parent")?;
+        let mut builder = std::fs::DirBuilder::new();
+        builder.recursive(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder.create(parent)?;
+        ensure!(
+            !std::fs::symlink_metadata(parent)?.file_type().is_symlink(),
+            "part cache directory is a symlink"
+        );
+        let temporary = self
+            .path
+            .with_extension(format!("{}.tmp", uuid::Uuid::new_v4()));
+        let result = (|| -> anyhow::Result<()> {
+            let mut file = open_options().create_new(true).open(&temporary)?;
+            file.try_lock().context("locking new part cache")?;
+            file.write_all(MAGIC)?;
+            file.write_all(&self.identity)?;
+            file.sync_all()?;
+            std::fs::hard_link(&temporary, &self.path)?;
+            self.file = Some(file);
+            Ok(())
+        })();
+        if let Err(error) = std::fs::remove_file(&temporary)
+            && error.kind() != std::io::ErrorKind::NotFound
+        {
+            tracing::warn!(?error, "removing temporary part cache");
+        }
+        result
+    }
+
+    fn append(&mut self, id: usize, offset: u64, data: &[u8]) -> anyhow::Result<u64> {
+        self.create()?;
+        let file = self.file.as_mut().unwrap();
+        file.set_len(self.committed)?;
+        file.seek(SeekFrom::Start(self.committed))?;
+        let mut header = [0; RECORD_HEADER];
+        header[..8].copy_from_slice(&(id as u64).to_le_bytes());
+        header[8..16].copy_from_slice(&offset.to_le_bytes());
+        header[16..].copy_from_slice(&(data.len() as u64).to_le_bytes());
+        file.write_all(&header)?;
+        file.write_all(data)?;
+        file.write_all(&checksum(&header, data))?;
+        let data_at = self.committed + RECORD_HEADER as u64;
+        self.committed = data_at + data.len() as u64 + CHECKSUM_LEN;
+        Ok(data_at)
+    }
+
+    pub(super) fn write(&mut self, id: usize, offset: u64, data: &[u8]) -> anyhow::Result<()> {
+        self.validate(id, offset, data.len() as u64)?;
+        if data.is_empty() {
+            return Ok(());
+        }
+        let position = self.append(id, offset, data)?;
+        self.insert(id, offset, data.len() as u64, position);
+        self.compact()?;
+        Ok(())
+    }
+
+    pub(super) fn read(
+        &self,
+        id: usize,
+        mut offset: u64,
+        mut buf: &mut [u8],
+        payload: &Path,
+    ) -> anyhow::Result<()> {
+        self.validate(id, offset, buf.len() as u64)?;
+        let map = &self.ranges[id];
+        let mut original = None;
+        while !buf.is_empty() {
+            let cached = map
+                .range(..=offset)
+                .next_back()
+                .filter(|(_, range)| range.end > offset);
+            let n = if let Some((&start, range)) = cached {
+                let n = usize::try_from((range.end - offset).min(buf.len() as u64))?;
+                self.file
+                    .as_ref()
+                    .context("missing part cache")?
+                    .pread_exact(range.data_at + offset - start, &mut buf[..n])?;
+                n
+            } else {
+                let end = map
+                    .range(offset..)
+                    .next()
+                    .map(|(&start, _)| start)
+                    .unwrap_or(u64::MAX);
+                let n = usize::try_from((end - offset).min(buf.len() as u64))?;
+                if original.is_none() {
+                    original = Some(File::open(payload)?);
+                }
+                original
+                    .as_ref()
+                    .unwrap()
+                    .pread_exact(offset, &mut buf[..n])?;
+                n
+            };
+            offset += n as u64;
+            buf = &mut buf[n..];
+        }
+        Ok(())
+    }
+
+    fn clear_index(&mut self, id: usize) {
+        self.live_bytes -= self.ranges[id]
+            .iter()
+            .map(|(&start, range)| range.end - start)
+            .sum::<u64>();
+        self.range_count -= self.ranges[id].len() as u64;
+        self.ranges[id].clear();
+    }
+
+    pub(super) fn remove_path(path: &Path) -> anyhow::Result<()> {
+        match std::fs::remove_file(path) {
+            Ok(()) => Ok(()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(error) => Err(error).context("removing part cache"),
+        }
+    }
+
+    pub(super) fn remove(&mut self) -> anyhow::Result<()> {
+        Self::remove_path(&self.path)?;
+        self.file = None;
+        self.ranges.iter_mut().for_each(BTreeMap::clear);
+        self.live_bytes = 0;
+        self.range_count = 0;
+        self.committed = HEADER_LEN;
+        Ok(())
+    }
+
+    pub(super) fn promote(&mut self, id: usize, target: &File) -> anyhow::Result<()> {
+        if self.ranges[id].is_empty() {
+            return Ok(());
+        }
+        let source = self.file.as_ref().context("missing part cache")?;
+        let mut buffer = [0; 65536];
+        for (&start, range) in &self.ranges[id] {
+            let mut copied = 0;
+            while copied < range.end - start {
+                let n = usize::try_from((range.end - start - copied).min(buffer.len() as u64))?;
+                source.pread_exact(range.data_at + copied, &mut buffer[..n])?;
+                target.pwrite_all(start + copied, &buffer[..n])?;
+                copied += n as u64;
+            }
+        }
+        target.sync_data()?;
+        self.append(id, CLEAR, &[])?;
+        self.clear_index(id);
+        self.compact()?;
+        Ok(())
+    }
+
+    fn compact(&mut self) -> anyhow::Result<()> {
+        let live = self.live_bytes + self.range_count * (RECORD_HEADER as u64 + CHECKSUM_LEN);
+        if self.committed <= HEADER_LEN + 2 * live + 2 * (RECORD_HEADER as u64 + CHECKSUM_LEN) {
+            return Ok(());
+        }
+        let temporary = self
+            .path
+            .with_extension(format!("{}.tmp", uuid::Uuid::new_v4()));
+        let result = (|| -> anyhow::Result<()> {
+            let mut target = open_options().create_new(true).open(&temporary)?;
+            target.try_lock()?;
+            target.write_all(MAGIC)?;
+            target.write_all(&self.identity)?;
+            let mut ranges = vec![BTreeMap::new(); self.lengths.len()];
+            let mut position = HEADER_LEN;
+            let source = self.file.as_ref().unwrap();
+            let mut buffer = [0; 65536];
+            for (id, map) in self.ranges.iter().enumerate() {
+                for (&start, range) in map {
+                    let length = range.end - start;
+                    let mut header = [0; RECORD_HEADER];
+                    header[..8].copy_from_slice(&(id as u64).to_le_bytes());
+                    header[8..16].copy_from_slice(&start.to_le_bytes());
+                    header[16..].copy_from_slice(&length.to_le_bytes());
+                    target.write_all(&header)?;
+                    let mut hash = Sha1::new();
+                    hash.update(&header);
+                    let mut copied = 0;
+                    while copied < length {
+                        let n = usize::try_from((length - copied).min(buffer.len() as u64))?;
+                        source.pread_exact(range.data_at + copied, &mut buffer[..n])?;
+                        hash.update(&buffer[..n]);
+                        target.write_all(&buffer[..n])?;
+                        copied += n as u64;
+                    }
+                    target.write_all(&hash.finish())?;
+                    ranges[id].insert(
+                        start,
+                        Range {
+                            end: range.end,
+                            data_at: position + RECORD_HEADER as u64,
+                        },
+                    );
+                    position += RECORD_HEADER as u64 + length + CHECKSUM_LEN;
+                }
+            }
+            target.sync_all()?;
+            std::fs::rename(&temporary, &self.path)?;
+            self.file = Some(target);
+            self.ranges = ranges;
+            self.committed = position;
+            Ok(())
+        })();
+        if result.is_err()
+            && let Err(error) = std::fs::remove_file(&temporary)
+            && error.kind() != std::io::ErrorKind::NotFound
+        {
+            tracing::warn!(?error, "removing temporary part cache");
+        }
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cache(root: &Path) -> anyhow::Result<PartFile> {
+        PartFile::open(root.join("parts/cache"), [7; 20], vec![1000])
+    }
+
+    #[test]
+    fn part_cache_is_lazy_and_overlays_without_touching_payload() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let payload = root.path().join("payload");
+        std::fs::write(&payload, b"abcdefghijklmnop")?;
+        let mut parts = cache(root.path())?;
+        assert!(!root.path().join("parts").exists());
+        parts.write(0, 4, b"123456")?;
+        parts.write(0, 6, b"XY")?;
+        let mut buf = [0; 16];
+        parts.read(0, 0, &mut buf, &payload)?;
+        assert_eq!(&buf, b"abcd12XY56klmnop");
+        assert_eq!(std::fs::read(&payload)?, b"abcdefghijklmnop");
+        drop(parts);
+        cache(root.path())?.read(0, 0, &mut buf, &payload)?;
+        assert_eq!(&buf, b"abcd12XY56klmnop");
+        Ok(())
+    }
+
+    #[test]
+    fn part_cache_recovers_incomplete_tail_and_rejects_corruption() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let payload = root.path().join("absent");
+        let mut parts = cache(root.path())?;
+        parts.write(0, 900, b"tail")?;
+        drop(parts);
+        OpenOptions::new()
+            .append(true)
+            .open(root.path().join("parts/cache"))?
+            .write_all(b"partial")?;
+        let mut parts = cache(root.path())?;
+        let mut buf = [0; 4];
+        parts.read(0, 900, &mut buf, &payload)?;
+        assert_eq!(&buf, b"tail");
+        assert!(parts.read(0, 0, &mut buf, &payload).is_err());
+        parts.write(0, 0, b"head")?;
+        drop(parts);
+        let file = open_options().open(root.path().join("parts/cache"))?;
+        file.pwrite_all(HEADER_LEN + RECORD_HEADER as u64, b"bad!")?;
+        assert!(cache(root.path()).is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn part_cache_promotion_preserves_gaps_and_invalidates_old_overlay() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let payload = root.path().join("payload");
+        std::fs::write(&payload, b"abcdefghijklmnop")?;
+        let mut parts = cache(root.path())?;
+        parts.write(0, 8, b"1234")?;
+        let target = open_options().open(&payload)?;
+        parts.promote(0, &target)?;
+        assert_eq!(std::fs::read(&payload)?, b"abcdefgh1234mnop");
+        target.pwrite_all(8, b"next")?;
+        drop(parts);
+        let mut buf = [0; 16];
+        cache(root.path())?.read(0, 0, &mut buf, &payload)?;
+        assert_eq!(&buf, b"abcdefghnextmnop");
+        Ok(())
+    }
+
+    #[test]
+    fn part_cache_repeated_writes_have_bounded_log_growth() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let mut parts = cache(root.path())?;
+        for byte in 0..100 {
+            parts.write(0, 500, &[byte; 100])?;
+        }
+        assert!(parts.file.as_ref().unwrap().metadata()?.len() < 600);
+        drop(parts);
+        let mut buf = [0; 100];
+        cache(root.path())?.read(0, 500, &mut buf, &root.path().join("absent"))?;
+        assert_eq!(buf, [99; 100]);
+        Ok(())
+    }
+
+    #[test]
+    fn part_cache_overlapping_ranges_survive_compaction_and_restart() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let payload = root.path().join("payload");
+        let original = vec![42; 1000];
+        std::fs::write(&payload, &original)?;
+        let mut expected = original.clone();
+        let mut parts = cache(root.path())?;
+        for step in 0..257 {
+            let offset = step * 73 % 900;
+            let length = 1 + step * 19 % 100;
+            let data = vec![u8::try_from(step % 251)?; length];
+            parts.write(0, offset as u64, &data)?;
+            expected[offset..offset + length].copy_from_slice(&data);
+            if step % 17 == 0 {
+                drop(parts);
+                parts = cache(root.path())?;
+            }
+            let mut actual = vec![0; 1000];
+            parts.read(0, 0, &mut actual, &payload)?;
+            assert_eq!(actual, expected);
+        }
+        assert_eq!(std::fs::read(&payload)?, original);
+        Ok(())
+    }
+
+    #[test]
+    fn part_cache_write_failure_does_not_publish_a_range() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let mut parts = cache(root.path())?;
+        std::fs::create_dir_all(root.path().join("parts/cache"))?;
+        assert!(parts.write(0, 0, b"not written").is_err());
+        assert!(parts.ranges[0].is_empty());
+        assert!(parts.file.is_none());
+        assert!(root.path().join("parts/cache").is_dir());
+        assert_eq!(std::fs::read_dir(root.path().join("parts"))?.count(), 1);
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn part_cache_refuses_symlinks_without_changing_their_target() -> anyhow::Result<()> {
+        let root = tempfile::tempdir()?;
+        let payload = root.path().join("payload");
+        std::fs::write(&payload, b"user bytes")?;
+        std::fs::create_dir(root.path().join("parts"))?;
+        std::os::unix::fs::symlink(&payload, root.path().join("parts/cache"))?;
+        assert!(cache(root.path()).is_err());
+        assert_eq!(std::fs::read(&payload)?, b"user bytes");
+        Ok(())
+    }
+}
