+#[tokio::test]
+async fn selective_storage_initial_check_finds_cached_suffix_after_missing_prefix()
+-> anyhow::Result<()> {
+    let (root, session, handle) = fixture().await?;
+    let id = skipped_id(&handle);
+    let metadata = handle.metadata.load_full().context("no metadata")?;
+    let piece_id = metadata.file_infos[id].piece_range.end - 1;
+    let piece = metadata
+        .lengths()
+        .iter_piece_infos()
+        .find(|piece| piece.piece_index.get() == piece_id)
+        .context("no suffix piece")?;
+    let start = piece_id as u64 * metadata.info.info().piece_length as u64;
+    let end = start + piece.len as u64;
+    assert!(start > metadata.file_infos[id].offset_in_torrent + 19);
+    handle.with_state(|state| -> anyhow::Result<()> {
+        let ManagedTorrentState::Paused(paused) = state else {
+            anyhow::bail!("not paused")
+        };
+        for (file_id, file) in metadata.file_infos.iter().enumerate() {
+            let from = start.max(file.offset_in_torrent);
+            let to = end.min(file.offset_in_torrent + file.len);
+            if from >= to {
+                continue;
+            }
+            let data = std::fs::read(root.path().join("source").join(&file.relative_filename))?;
+            let offset = usize::try_from(from - file.offset_in_torrent)?;
+            paused.files.pwrite_all(
+                file_id,
+                offset as u64,
+                &data[offset..offset + usize::try_from(to - from)?],
+            )?;
+        }
+        let have =
+            crate::file_ops::FileOps::new(&metadata.info, &*paused.files, &metadata.file_infos)
+                .initial_check(
+                    &std::sync::atomic::AtomicU64::new(0),
+                    &std::sync::atomic::AtomicBool::new(false),
+                )?;
+        assert!(
+            have[piece_id as usize],
+            "valid cached suffix was lost after an earlier missing range"
+        );
+        Ok(())
+    })?;
+    assert_eq!(
+        std::fs::read(root.path().join("output/skipped/middle.bin"))?,
+        b"existing user bytes"
+    );
+    drop(handle);
+    session.stop().await;
+    Ok(())
+}
